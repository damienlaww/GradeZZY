<?xml version="1.0" encoding="UTF-8"?>

<!--
  Results screen: one row per student with Q1a /3 to Q3 /4 and Total /20,
  search, filter, sort, multi-selection, export and an inspector for the
  selected student.
  Controller: gradezzy.ui.ResultsController
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.ResultsController">
    <VBox styleClass="page">
        <VBox styleClass="page-heading">
            <HBox styleClass="page-header">
                <Label text="Results" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="jsonButton" text="Export JSON"
                        onAction="#handleExportJson"/>
                <Button fx:id="csvButton" text="Export Score Sheet"
                        styleClass="accent, primary-action"
                        onAction="#handleExportCsv"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="page-status"
                   wrapText="true"/>
        </VBox>

        <FlowPane fx:id="filterBar" styleClass="filter-bar" hgap="12" vgap="8">
            <TextField fx:id="searchField" styleClass="search-field"
                       promptText="Search students"
                       accessibleText="Search students"
                       onAction="#handleSearch"/>
            <HBox styleClass="segmented">
                <ToggleButton fx:id="namesScope" text="Names"
                              styleClass="left-pill"
                              accessibleText="Search names and usernames"/>
                <ToggleButton fx:id="codeScope" text="Code"
                              styleClass="right-pill"
                              accessibleText="Search inside source code"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="stateLabel" text="Status"
                       styleClass="filter-label"/>
                <ComboBox fx:id="stateFilter" accessibleText="Status filter"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="sortLabel" text="Sort" styleClass="filter-label"/>
                <ComboBox fx:id="sortBox" accessibleText="Sort order"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="selectAllButton" text="Select All"
                        onAction="#handleSelectAll"/>
                <Button fx:id="clearSelectionButton" text="Clear Selection"
                        onAction="#handleClearSelection"/>
                <ToggleButton fx:id="inspectorToggle" text="Inspector"
                              accessibleText="Show the selected student"/>
            </HBox>
        </FlowPane>

        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <VBox styleClass="panel, flush" HBox.hgrow="ALWAYS">
                <TableView fx:id="table" styleClass="tall-rows"
                           VBox.vgrow="ALWAYS" minHeight="260"
                           accessibleText="Results, one row per student"/>
                <HBox fx:id="legend" styleClass="legend"/>
            </VBox>

            <VBox fx:id="inspector" styleClass="inspector">
                <Label text="SELECTED STUDENT" styleClass="eyebrow"/>
                <Label fx:id="nameLabel" styleClass="panel-title"
                       wrapText="true"/>
                <Label fx:id="usernameLabel" styleClass="secondary-text, mono"/>
                <HBox spacing="8" alignment="BASELINE_LEFT">
                    <Label fx:id="totalLabel" styleClass="big-number"/>
                    <Label fx:id="maxLabel" styleClass="secondary-text"/>
                </HBox>
                <HBox fx:id="stateHolder"/>
                <VBox fx:id="questionRows" spacing="8"/>
                <Label fx:id="noteLabel" wrapText="true"
                       styleClass="secondary-text"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="openButton" text="Open Student Evidence"
                        maxWidth="Infinity" onAction="#handleOpenStudent"/>
                <Label text="The original ZIP file is never changed."
                       styleClass="secondary-text" wrapText="true"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>

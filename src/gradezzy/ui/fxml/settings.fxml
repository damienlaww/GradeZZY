<?xml version="1.0" encoding="UTF-8"?>

<!--
  Settings screen: grouped inset lists in the style of macOS System
  Settings, for grading, execution, detection, export, storage and
  appearance. Each text setting is checked as it is typed.
  Tier: SHOULD. Owner: Damien.
  Controller: gradezzy.ui.SettingsController
  AI use: drafted with Claude Code, reviewed by Jun Sheng.
-->

<?import atlantafx.base.controls.ToggleSwitch?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.SettingsController">
    <VBox styleClass="page">
        <VBox styleClass="page-heading">
            <HBox styleClass="page-header">
                <Label text="Settings" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Reset" onAction="#handleReset"/>
                <Button fx:id="saveButton" text="Save"
                        styleClass="accent, primary-action"
                        onAction="#handleSave"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="page-status"
                   wrapText="true"/>
        </VBox>

        <VBox spacing="20" maxWidth="760">

            <!-- Grading -->
            <VBox spacing="4">
                <Label text="Grading" styleClass="settings-heading"/>
                <VBox styleClass="settings-group">
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label wrapText="true">
                                <text>
                                    Apply repairs to working copies
                                    automatically
                                </text>
                            </Label>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Each repair still waits for your approval
                                    and can be undone.
                                </text>
                            </Label>
                        </VBox>
                        <ToggleSwitch fx:id="autoFixSwitch">
                            <accessibleText>
                                Apply repairs to working copies automatically
                            </accessibleText>
                        </ToggleSwitch>
                    </HBox>
                    <HBox styleClass="settings-row, last">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Rubric" wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Read only. Set by the assessment settings in
                                    config.properties.
                                </text>
                            </Label>
                        </VBox>
                        <Label fx:id="rubricValue" styleClass="context-value"
                               minWidth="-Infinity"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Execution -->
            <VBox spacing="4">
                <Label text="Execution" styleClass="settings-heading"/>
                <VBox styleClass="settings-group">
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Tester time limit (seconds)"
                                   wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    One tester run covers every case of one
                                    question. Safe default: 10.
                                </text>
                            </Label>
                            <Label fx:id="runTimeoutError"
                                   styleClass="field-error" wrapText="true"/>
                        </VBox>
                        <TextField fx:id="runTimeoutField" prefColumnCount="6">
                            <accessibleText>
                                Tester time limit in seconds
                            </accessibleText>
                        </TextField>
                    </HBox>
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Compile time limit (seconds)"
                                   wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    For one question folder. Safe default: 30.
                                </text>
                            </Label>
                            <Label fx:id="compileTimeoutError"
                                   styleClass="field-error" wrapText="true"/>
                        </VBox>
                        <TextField fx:id="compileTimeoutField"
                                   prefColumnCount="6">
                            <accessibleText>
                                Compile time limit in seconds
                            </accessibleText>
                        </TextField>
                    </HBox>
                    <HBox styleClass="settings-row, last">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Submissions graded at once"
                                   wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    More is faster on a computer with more
                                    cores. Safe default: 4.
                                </text>
                            </Label>
                            <Label fx:id="threadCountError"
                                   styleClass="field-error" wrapText="true"/>
                        </VBox>
                        <TextField fx:id="threadCountField" prefColumnCount="6"
                                   accessibleText="Submissions graded at once"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Detection -->
            <VBox spacing="4">
                <Label text="Detection" styleClass="settings-heading"/>
                <VBox styleClass="settings-group">
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Flag untouched starter files"
                                   wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true"
                                   text="Flags never change marks."/>
                        </VBox>
                        <ToggleSwitch fx:id="untouchedSwitch">
                            <accessibleText>
                                Flag untouched starter files
                            </accessibleText>
                        </ToggleSwitch>
                    </HBox>
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Flag empty answers" wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true"
                                   text="Flags never change marks."/>
                        </VBox>
                        <ToggleSwitch fx:id="emptySwitch"
                                      accessibleText="Flag empty answers"/>
                    </HBox>
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Flag possible hard-coded answers"
                                   wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true"
                                   text="Flags never change marks."/>
                        </VBox>
                        <ToggleSwitch fx:id="hardCodedSwitch">
                            <accessibleText>
                                Flag possible hard-coded answers
                            </accessibleText>
                        </ToggleSwitch>
                    </HBox>
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Similarity check after grading"
                                   wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Off by default. A review aid only; it never
                                    claims misconduct.
                                </text>
                            </Label>
                        </VBox>
                        <ToggleSwitch fx:id="similaritySwitch">
                            <accessibleText>
                                Similarity check after grading
                            </accessibleText>
                        </ToggleSwitch>
                    </HBox>
                    <HBox styleClass="settings-row, last">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Similarity threshold (0 to 1)"
                                   wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Pairs at or above this share are listed for
                                    review. Safe default: 0.80.
                                </text>
                            </Label>
                            <Label fx:id="thresholdError"
                                   styleClass="field-error" wrapText="true"/>
                        </VBox>
                        <TextField fx:id="thresholdField" prefColumnCount="6">
                            <accessibleText>
                                Similarity threshold from 0 to 1
                            </accessibleText>
                        </TextField>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Export -->
            <VBox spacing="4">
                <Label text="Export" styleClass="settings-heading"/>
                <VBox styleClass="settings-group">
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Formats" wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Read only. No Excel library is bundled, so
                                    XLSX is not offered.
                                </text>
                            </Label>
                        </VBox>
                        <Label fx:id="formatsValue" styleClass="context-value"
                               wrapText="true"/>
                    </HBox>
                    <HBox styleClass="settings-row, last">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="CSV line ending" wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Read only. Matches the provided score sheet.
                                </text>
                            </Label>
                        </VBox>
                        <Label fx:id="lineEndingValue"
                               styleClass="context-value"
                               minWidth="-Infinity"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Storage -->
            <VBox spacing="4">
                <Label text="Storage" styleClass="settings-heading"/>
                <VBox styleClass="settings-group">
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Database file" wrapText="true"/>
                            <Label fx:id="databaseValue"
                                   styleClass="mono"
                                   wrapText="true"/>
                        </VBox>
                        <Label text="Read only" styleClass="field-help"
                               minWidth="-Infinity"/>
                    </HBox>
                    <HBox styleClass="settings-row">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Backup folder" wrapText="true"/>
                            <Label fx:id="backupDirValue"
                                   styleClass="mono"
                                   wrapText="true"/>
                        </VBox>
                        <Label text="Read only" styleClass="field-help"
                               minWidth="-Infinity"/>
                    </HBox>
                    <HBox styleClass="settings-row, last">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Backups kept" wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    The oldest backup is deleted when there are
                                    more. Safe default: 5.
                                </text>
                            </Label>
                            <Label fx:id="backupKeepError"
                                   styleClass="field-error" wrapText="true"/>
                        </VBox>
                        <TextField fx:id="backupKeepField" prefColumnCount="6"
                                   accessibleText="Backups kept"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Appearance -->
            <VBox spacing="4">
                <Label text="Appearance" styleClass="settings-heading"/>
                <VBox styleClass="settings-group">
                    <VBox styleClass="settings-row">
                        <VBox spacing="4">
                            <Label text="Theme" wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Changes at once on every screen. Save keeps
                                    the choice in config.properties.
                                </text>
                            </Label>
                        </VBox>
                        <HBox spacing="20">
                            <VBox spacing="8">
                                <VBox fx:id="lightPreview"
                                      styleClass="theme-preview, light-preview"
                                      maxWidth="-Infinity"
                                      accessibleText="Light theme preview">
                                    <Region styleClass="preview-bar"/>
                                    <Label styleClass="preview-text">
                                        <text>Light</text>
                                    </Label>
                                </VBox>
                                <HBox fx:id="lightChoice" spacing="8"
                                      alignment="CENTER_LEFT">
                                    <Button text="Use Light"
                                            onAction="#handleUseLight"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="8">
                                <VBox fx:id="darkPreview"
                                      styleClass="theme-preview, dark-preview"
                                      maxWidth="-Infinity"
                                      accessibleText="Dark theme preview">
                                    <Region styleClass="preview-bar"/>
                                    <Label styleClass="preview-text">
                                        <text>Dark</text>
                                    </Label>
                                </VBox>
                                <HBox fx:id="darkChoice" spacing="8"
                                      alignment="CENTER_LEFT">
                                    <Button text="Use Dark"
                                            onAction="#handleUseDark"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                    <HBox styleClass="settings-row, last">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">
                            <Label text="Animations" wrapText="true"/>
                            <Label styleClass="field-help" wrapText="true">
                                <text>
                                    Short fades and slides. Off means no motion
                                    at all. Changes at once.
                                </text>
                            </Label>
                        </VBox>
                        <ToggleSwitch fx:id="animationsSwitch"
                                      accessibleText="Animations"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>

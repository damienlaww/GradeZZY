<?xml version="1.0" encoding="UTF-8"?>

<!--
  Assessments screen: the rubric with its folders, files and testers, the
  time limits, the tester output format, and the tester source: a tester
  folder or typed test cases.
  Tier: SHOULD. Owner: Damien.
  Controller: gradezzy.ui.TestCaseController
  AI use: drafted with Claude Code, reviewed by Jun Sheng.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.TestCaseController">
    <VBox styleClass="page">
        <VBox styleClass="page-heading">
            <HBox styleClass="page-header">
                <Label text="Assessments" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Prepare Submissions"
                        styleClass="accent, primary-action"
                        onAction="#handleOpenSubmissions"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="page-status"
                   wrapText="true"/>
        </VBox>

        <GridPane fx:id="columns" hgap="16" vgap="16">
            <VBox fx:id="rubricPanel" styleClass="panel, flush">
                <HBox styleClass="panel-header">
                    <Label text="Rubric" styleClass="panel-title"/>
                </HBox>
                <TableView fx:id="rubricTable"
                           accessibleText="Rubric, one row per question"/>
                <HBox styleClass="legend">
                    <Label fx:id="totalLabel" styleClass="context-value"/>
                </HBox>
            </VBox>

            <VBox fx:id="limitsPanel" styleClass="panel">
                <Label text="Time limits and tester output"
                       styleClass="panel-title"/>
                <Label fx:id="limitsLabel" wrapText="true"/>
                <Label fx:id="outputLabel" wrapText="true"/>
                <Label styleClass="secondary-text" wrapText="true">
                    <text>
                        A tester that runs past the limit is stopped. Cases it
                        finished keep their marks.
                    </text>
                </Label>
            </VBox>
        </GridPane>

        <VBox styleClass="panel">
            <Label text="Tester source" styleClass="panel-title"/>
            <Label styleClass="secondary-text" wrapText="true">
                <text>
                    Grading uses a tester folder or typed test cases. The tester
                    group on the Submissions screen reads the same choice.
                </text>
            </Label>
            <HBox styleClass="segmented">
                <ToggleButton fx:id="folderToggle" text="Tester Folder"
                              styleClass="left-pill"
                              accessibleText="Use a tester folder"/>
                <ToggleButton fx:id="typedToggle" text="Typed Test Cases"
                              styleClass="right-pill"
                              accessibleText="Use typed test cases"/>
            </HBox>

            <VBox fx:id="folderBox" spacing="8">
                <Label fx:id="folderHelp" styleClass="secondary-text"
                       wrapText="true"/>
                <HBox fx:id="testerStatus" styleClass="file-row"/>
                <HBox styleClass="toolbar">
                    <Button text="Choose Tester Folder"
                            onAction="#handleUploadTesters"/>
                </HBox>
            </VBox>

            <VBox fx:id="typedBox" spacing="8">
                <Label styleClass="secondary-text" wrapText="true">
                    <text>
                        Each case names a question, the student method to call,
                        its arguments and the expected result, all written as
                        Java.
                    </text>
                </Label>
                <TableView fx:id="caseTable" prefHeight="220" minHeight="160"
                           accessibleText="Typed test cases"/>
                <HBox styleClass="toolbar">
                    <Button text="Add Test Case"
                            onAction="#handleAddTestCase"/>
                    <Button fx:id="removeButton" text="Remove Selected"
                            onAction="#handleRemoveTestCase"/>
                    <Label fx:id="caseCountLabel" styleClass="secondary-text"
                           wrapText="true"/>
                </HBox>
                <Label fx:id="typedNote" styleClass="secondary-text"
                       wrapText="true"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>

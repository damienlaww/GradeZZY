<?xml version="1.0" encoding="UTF-8"?>

<!--
  Statistics screen: completion, mean, median and pass rate of the graded
  students, the score distribution, question difficulty, anomaly
  frequency and common mistakes, for one module and section. Ungraded
  students are left out, never counted as zero. Every chart has a text
  summary.
  Controller: gradezzy.ui.StatisticsController
-->

<?import gradezzy.ui.component.MetricTile?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.StatisticsController">
    <VBox styleClass="page">
        <VBox styleClass="page-heading">
            <HBox styleClass="page-header">
                <Label text="Statistics" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="copyButton" text="Copy Summary"
                        styleClass="accent, primary-action"
                        onAction="#handleCopySummary"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="page-status"
                   wrapText="true"/>
        </VBox>

        <FlowPane styleClass="filter-bar" hgap="12" vgap="8">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="moduleLabel" text="Module"
                       styleClass="filter-label"/>
                <ComboBox fx:id="moduleBox" accessibleText="Module"
                          onAction="#handleFilterChanged"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="sectionLabel" text="Section"
                       styleClass="filter-label"/>
                <ComboBox fx:id="sectionBox" accessibleText="Section"
                          onAction="#handleFilterChanged"/>
            </HBox>
        </FlowPane>

        <VBox fx:id="emptyHolder" styleClass="panel"/>

        <VBox fx:id="contentBox" spacing="16">
            <FlowPane fx:id="metrics" hgap="12" vgap="12">
                <MetricTile fx:id="completionTile" name="Completion"/>
                <MetricTile fx:id="meanTile" name="Mean"/>
                <MetricTile fx:id="medianTile" name="Median"/>
                <MetricTile fx:id="passTile" name="Pass rate"/>
            </FlowPane>

            <VBox styleClass="panel">
                <Label text="Score distribution" styleClass="panel-title"/>
                <Label fx:id="distributionSummary" wrapText="true"/>
                <BarChart fx:id="distributionChart" legendVisible="false"
                          animated="false" prefHeight="320" minHeight="260"
                          verticalGridLinesVisible="false">
                    <xAxis>
                        <NumberAxis fx:id="countAxis" label="Students"
                                    minorTickVisible="false"
                                    forceZeroInRange="true"
                                    autoRanging="false" animated="false"/>
                    </xAxis>
                    <yAxis>
                        <CategoryAxis fx:id="bandAxis" label="Total marks"
                                      animated="false"/>
                    </yAxis>
                </BarChart>
                <Label fx:id="distributionNote" styleClass="secondary-text"
                       wrapText="true"/>
            </VBox>

            <GridPane fx:id="columns" hgap="16" vgap="16">
                <VBox fx:id="difficultyPanel" styleClass="panel">
                    <Label text="Question difficulty"
                           styleClass="panel-title"/>
                    <Label fx:id="difficultySummary" wrapText="true"/>
                    <VBox fx:id="difficultyRows" spacing="8"/>
                    <Label fx:id="difficultyNote" styleClass="secondary-text"
                           wrapText="true"/>
                </VBox>
                <VBox fx:id="anomalyPanel" styleClass="panel">
                    <Label text="Anomaly frequency" styleClass="panel-title"/>
                    <Label fx:id="anomalySummary" wrapText="true"/>
                    <VBox fx:id="anomalyRows" spacing="8"/>
                    <Label styleClass="secondary-text" wrapText="true">
                        <text>
                            Flags request a review. They never change a mark.
                        </text>
                    </Label>
                </VBox>
            </GridPane>

            <VBox styleClass="panel">
                <Label text="Common mistakes" styleClass="panel-title"/>
                <Label text="MOST FAILED TEST CASE" styleClass="eyebrow"/>
                <Label fx:id="mostFailedLabel" wrapText="true"/>
                <Label text="COMPILE ERRORS" styleClass="eyebrow"/>
                <VBox fx:id="compileRows" spacing="8"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>

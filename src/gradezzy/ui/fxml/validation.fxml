<?xml version="1.0" encoding="UTF-8"?>

<!--
  Validation screen: the validation findings of the run, each with what
  the student submitted and the change proposed for the working copy,
  with approve, reject and undo for one repair or several, and an
  inspector for the focused finding. The original ZIP is never changed.
  Tier: SHOULD. Owner: Damien.
  Controller: gradezzy.ui.ValidationController
  AI use: drafted with Claude Code, reviewed by Jun Sheng.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.ValidationController">
    <VBox styleClass="page">
        <VBox styleClass="page-heading">
            <HBox styleClass="page-header">
                <Label text="Validation" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="undoAllButton" text="Undo All"
                        onAction="#handleUndoAll"/>
                <Button fx:id="rejectButton" text="Reject Selected"
                        onAction="#handleRejectSelected"/>
                <Button fx:id="approveButton" text="Approve Selected"
                        styleClass="accent, primary-action"
                        onAction="#handleApproveSelected"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="statusLabel" styleClass="page-status"
                       wrapText="true" maxWidth="Infinity"
                       minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Review Anomalies" styleClass="link-button"
                        onAction="#handleOpenAnomalies"/>
            </HBox>
        </VBox>

        <HBox styleClass="banner">
            <Label wrapText="true" minHeight="-Infinity">
                <text>
                    Original ZIP files are never changed. Repairs change working
                    copies only, and each one can be rejected or undone.
                </text>
            </Label>
        </HBox>

        <HBox fx:id="valuesNote" styleClass="banner">
            <Label wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                   minHeight="-Infinity">
                <text>
                    The original and proposed values of each repair are not
                    recorded yet, so both show Not recorded yet.
                </text>
            </Label>
            <Button text="See What Is Needed" styleClass="link-button"
                    onAction="#handleValuesNotConnected"/>
        </HBox>

        <FlowPane styleClass="filter-bar" hgap="12" vgap="8">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="studentLabel" text="Student"
                       styleClass="filter-label"/>
                <ComboBox fx:id="studentFilter">
                    <accessibleText>Student filter</accessibleText>
                </ComboBox>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="stateLabel" styleClass="filter-label">
                    <text>State</text>
                </Label>
                <ComboBox fx:id="stateFilter"
                          accessibleText="Repair state filter"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="selectAllButton" text="Select All"
                        onAction="#handleSelectAll"/>
                <Button fx:id="clearSelectionButton" text="Clear Selection"
                        onAction="#handleClearSelection"/>
                <ToggleButton fx:id="inspectorToggle" text="Inspector"
                              accessibleText="Show the focused finding"/>
            </HBox>
        </FlowPane>

        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <VBox styleClass="panel, flush" HBox.hgrow="ALWAYS">
                <TableView fx:id="table" styleClass="tall-rows"
                           VBox.vgrow="ALWAYS" minHeight="260">
                    <accessibleText>
                        Validation findings, one row per finding
                    </accessibleText>
                </TableView>
            </VBox>

            <VBox fx:id="inspector" styleClass="inspector">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS">
                    <VBox spacing="12">
                        <Label text="FINDING" styleClass="eyebrow"/>
                        <Label fx:id="titleLabel" styleClass="panel-title"
                               wrapText="true"/>
                        <Label fx:id="hintLabel" styleClass="secondary-text"
                               wrapText="true"/>
                        <VBox fx:id="detailBox" spacing="12">
                            <VBox spacing="0">
                                <Label fx:id="nameLabel"
                                       styleClass="context-value"
                                       wrapText="true"/>
                                <Label fx:id="usernameLabel"
                                       styleClass="secondary-text, mono"/>
                            </VBox>
                            <HBox fx:id="stateHolder"/>
                            <HBox fx:id="blockedBanner"
                                  styleClass="banner, tone-warning">
                                <Label wrapText="true">
                                    <text>
                                        No automatic repair exists. GradeZZY
                                        never writes a missing answer or renames
                                        files it cannot match.
                                    </text>
                                </Label>
                            </HBox>
                            <Label fx:id="messageLabel" wrapText="true"/>
                            <VBox spacing="4">
                                <Label text="SUGGESTED ACTION"
                                       styleClass="eyebrow"/>
                                <Label fx:id="actionLabel" wrapText="true"/>
                            </VBox>
                            <VBox styleClass="raised" spacing="4">
                                <padding>
                                    <Insets top="8" right="12" bottom="8"
                                            left="12"/>
                                </padding>
                                <Label text="Original, in the student's ZIP"
                                       styleClass="secondary-text"/>
                                <Label fx:id="originalLabel" styleClass="mono"
                                       wrapText="true"/>
                            </VBox>
                            <VBox styleClass="raised" spacing="4">
                                <padding>
                                    <Insets top="8" right="12" bottom="8"
                                            left="12"/>
                                </padding>
                                <Label text="Proposed working copy"
                                       styleClass="secondary-text"/>
                                <Label fx:id="proposedLabel" styleClass="mono"
                                       wrapText="true"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
                <VBox spacing="8">
                    <HBox spacing="8">
                        <Button fx:id="approveOneButton" text="Approve"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS"
                                onAction="#handleApproveFocused"/>
                        <Button fx:id="rejectOneButton" text="Reject"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#handleRejectFocused"/>
                    </HBox>
                    <Button fx:id="undoOneButton" text="Undo Decision"
                            maxWidth="Infinity"
                            onAction="#handleUndoFocused"/>
                    <Button fx:id="openButton" text="Open Student Evidence"
                            maxWidth="Infinity"
                            onAction="#handleOpenStudent"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>

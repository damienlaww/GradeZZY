<?xml version="1.0" encoding="UTF-8"?>

<!--
  Student Evidence screen: explains one student's result with the marks
  per question, every test case, the working-copy source, the logs, the
  repairs, the mark history and the anomalies. Offers Retry for the
  narrowest failed question, Retry Entire Submission, Adjust Score with
  a required reason and Undo, and Export Report.
  Tier: SHOULD. Owner: Damien.
  Controller: gradezzy.ui.StudentReportController
  AI use: drafted with Claude Code, reviewed by Jun Sheng.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.StudentReportController">
    <VBox styleClass="page">
        <VBox fx:id="emptyHolder" VBox.vgrow="ALWAYS"/>

        <VBox fx:id="contentBox" spacing="16" VBox.vgrow="ALWAYS">
            <VBox styleClass="page-heading">
                <HBox>
                    <Button fx:id="backButton" text="Back to Results"
                            styleClass="link-button"
                            accessibleText="Back to Results"
                            onAction="#handleBack"/>
                </HBox>
                <HBox styleClass="page-header">
                    <Label fx:id="titleLabel" styleClass="page-title"
                           minWidth="0"/>
                    <HBox fx:id="stateHolder" alignment="CENTER_LEFT"
                          minWidth="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="retryButton" text="Retry Question"
                            styleClass="accent, primary-action"
                            onAction="#handleRetryQuestion"/>
                </HBox>
                <Label fx:id="statusLabel" styleClass="page-status"
                       wrapText="true" minHeight="-Infinity"/>
            </VBox>

            <FlowPane fx:id="actionBar" hgap="8" vgap="8"
                      minHeight="-Infinity">
                <Button fx:id="retrySubmissionButton"
                        text="Retry Entire Submission"
                        onAction="#handleRetrySubmission"/>
                <Button fx:id="adjustButton" text="Adjust Score"
                        onAction="#handleAdjustScore"/>
                <Button fx:id="exportButton" text="Export Report"
                        onAction="#handleExport"/>
            </FlowPane>

            <HBox fx:id="savedBar" styleClass="banner, tone-success"
                  minHeight="-Infinity">
                <VBox fx:id="savedBox" spacing="4" HBox.hgrow="ALWAYS"
                      maxWidth="Infinity"/>
                <Button fx:id="undoButton" text="Undo"
                        accessibleText="Undo the last mark change"
                        onAction="#handleUndoAdjustment"/>
            </HBox>

            <FlowPane fx:id="scoreChips" hgap="8" vgap="8"
                      minHeight="-Infinity"
                      accessibleText="Marks per question"/>

            <TabPane fx:id="tabs" VBox.vgrow="ALWAYS" minHeight="380"
                     prefHeight="380" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab fx:id="casesTab" text="Cases">
                        <content>
                            <ScrollPane fitToWidth="true" fitToHeight="true"
                                        styleClass="page-scroll">
                                <GridPane fx:id="casesGrid" hgap="16"
                                          vgap="16">
                                    <VBox fx:id="casesPanel"
                                          styleClass="panel, flush">
                                        <TableView fx:id="caseTable"
                                                   VBox.vgrow="ALWAYS"
                                                   minHeight="200">
                                            <accessibleText>
                                                Test cases of every question
                                            </accessibleText>
                                        </TableView>
                                    </VBox>
                                    <VBox fx:id="caseDetails"
                                          styleClass="panel">
                                        <Label text="SELECTED CASE"
                                               styleClass="eyebrow"/>
                                        <Label fx:id="caseTitle"
                                               styleClass="panel-title"
                                               wrapText="true"
                                               minHeight="-Infinity"/>
                                        <HBox fx:id="caseBadgeHolder"/>
                                        <VBox fx:id="caseFacts" spacing="12">
                                            <GridPane fx:id="caseGrid"
                                                      styleClass="detail-grid">
                                                <columnConstraints>
                                                    <ColumnConstraints
                                                            minWidth="80"/>
                                                    <ColumnConstraints
                                                            hgrow="ALWAYS"/>
                                                </columnConstraints>
                                                <Label text="Expected"
                                                       styleClass="detail-name"
                                                       GridPane.rowIndex="0"/>
                                                <Label fx:id="expectedLabel"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="0"/>
                                                <Label text="Actual"
                                                       styleClass="detail-name"
                                                       GridPane.rowIndex="1"/>
                                                <Label fx:id="actualLabel"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="1"/>
                                                <Label text="Time limit"
                                                       styleClass="detail-name"
                                                       GridPane.rowIndex="2"/>
                                                <Label fx:id="limitLabel"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="2"/>
                                                <Label text="Marks kept"
                                                       styleClass="detail-name"
                                                       GridPane.rowIndex="3"/>
                                                <Label fx:id="keptLabel"
                                                       wrapText="true"
                                                       minHeight="-Infinity"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="3"/>
                                            </GridPane>
                                            <Label fx:id="excerptTitle"
                                                   text="LOG EXCERPT"
                                                   styleClass="eyebrow"/>
                                            <StackPane fx:id="excerptHolder"
                                                       minHeight="112"
                                                       prefHeight="112">
                                                <TextArea fx:id="excerptArea"
                                                          styleClass="code-view"
                                                          editable="false"
                                                         >
                                                    <accessibleText>
                                                        Last lines of the output
                                                    </accessibleText>
                                                    <promptText>
                                                        The tester printed
                                                        nothing.
                                                    </promptText>
                                                </TextArea>
                                            </StackPane>
                                        </VBox>
                                        <HBox fx:id="adviceBanner"
                                              styleClass="banner"
                                              minHeight="-Infinity">
                                            <Label fx:id="adviceLabel"
                                                   wrapText="true"
                                                   minHeight="-Infinity"
                                                   HBox.hgrow="ALWAYS"
                                                   maxWidth="Infinity"/>
                                        </HBox>
                                    </VBox>
                                </GridPane>
                            </ScrollPane>
                        </content>
                    </Tab>

                    <Tab fx:id="sourceTab" text="Source">
                        <content>
                            <VBox spacing="8">
                                <Label fx:id="sourceNote"
                                       styleClass="secondary-text"
                                       wrapText="true"
                                       minHeight="-Infinity"/>
                                <StackPane VBox.vgrow="ALWAYS">
                                    <SplitPane fx:id="sourceSplit"
                                               dividerPositions="0.3">
                                        <items>
                                            <TreeView fx:id="fileTree"
                                                      minWidth="140">
                                                <accessibleText>
                                                    Files of the working copy
                                                </accessibleText>
                                            </TreeView>
                                            <StackPane>
                                                <TextArea fx:id="sourceArea"
                                                          styleClass="code-view"
                                                          editable="false">
                                                    <accessibleText>
                                                        Text of the chosen file
                                                    </accessibleText>
                                                </TextArea>
                                                <VBox fx:id="fileEmptyHolder"
                                                      styleClass="panel"/>
                                            </StackPane>
                                        </items>
                                    </SplitPane>
                                    <VBox fx:id="sourceEmptyHolder"
                                          styleClass="panel"/>
                                </StackPane>
                            </VBox>
                        </content>
                    </Tab>

                    <Tab fx:id="logsTab" text="Logs">
                        <content>
                            <VBox spacing="8">
                                <FlowPane styleClass="filter-bar" hgap="12"
                                          vgap="8">
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label fx:id="logQuestionLabel"
                                               text="Question"
                                               styleClass="filter-label"/>
                                        <ComboBox fx:id="logQuestionBox">
                                            <accessibleText>
                                                Question whose output is shown
                                            </accessibleText>
                                        </ComboBox>
                                    </HBox>
                                    <Label fx:id="logCountLabel"
                                           styleClass="secondary-text"
                                           wrapText="true"/>
                                </FlowPane>
                                <TextArea fx:id="logArea"
                                          styleClass="code-view"
                                          editable="false"
                                          VBox.vgrow="ALWAYS"
                                         >
                                    <accessibleText>
                                        Compiler and tester output
                                    </accessibleText>
                                    <promptText>
                                        This question printed no output.
                                    </promptText>
                                </TextArea>
                            </VBox>
                        </content>
                    </Tab>

                    <Tab fx:id="repairsTab" text="Repairs">
                        <content>
                            <VBox spacing="12">
                                <HBox styleClass="banner"
                                      minHeight="-Infinity">
                                    <Label wrapText="true" HBox.hgrow="ALWAYS"
                                           minHeight="-Infinity"
                                           maxWidth="Infinity">
                                        <text>
                                            Repairs change only the working
                                            copy. The original ZIP file is
                                            unchanged.
                                        </text>
                                    </Label>
                                    <Button text="Open Validation"
                                            styleClass="link-button"
                                            onAction="#handleOpenValidation"/>
                                </HBox>
                                <ScrollPane fitToWidth="true"
                                            styleClass="page-scroll"
                                            VBox.vgrow="ALWAYS">
                                    <VBox fx:id="repairRows" spacing="12"/>
                                </ScrollPane>
                            </VBox>
                        </content>
                    </Tab>

                    <Tab fx:id="historyTab" text="History">
                        <content>
                            <StackPane>
                                <VBox fx:id="historyContent" spacing="8">
                                    <Label text="Mark changes"
                                           styleClass="panel-title"/>
                                    <VBox styleClass="panel, flush"
                                          VBox.vgrow="ALWAYS">
                                        <TableView fx:id="adjustmentTable"
                                                   VBox.vgrow="ALWAYS"
                                                   minHeight="110">
                                            <accessibleText>
                                                Marks changed by hand
                                            </accessibleText>
                                        </TableView>
                                    </VBox>
                                    <Label fx:id="auditTitle"
                                           styleClass="panel-title"/>
                                    <VBox styleClass="panel, flush"
                                          VBox.vgrow="ALWAYS">
                                        <TableView fx:id="auditTable"
                                                   VBox.vgrow="ALWAYS"
                                                   minHeight="110">
                                            <accessibleText>
                                                Audit entries about this student
                                            </accessibleText>
                                        </TableView>
                                    </VBox>
                                </VBox>
                                <VBox fx:id="historyEmptyHolder"
                                      styleClass="panel"/>
                            </StackPane>
                        </content>
                    </Tab>

                    <Tab fx:id="anomaliesTab" text="Anomalies">
                        <content>
                            <VBox spacing="12">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label fx:id="anomalySummary"
                                           wrapText="true" HBox.hgrow="ALWAYS"
                                           minHeight="-Infinity"
                                           maxWidth="Infinity"/>
                                    <Button text="Review All Anomalies"
                                            styleClass="link-button"
                                            onAction="#handleReviewAnomalies"/>
                                </HBox>
                                <ScrollPane fitToWidth="true"
                                            styleClass="page-scroll"
                                            VBox.vgrow="ALWAYS">
                                    <VBox fx:id="anomalyRows" spacing="12"/>
                                </ScrollPane>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </VBox>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<!--
  History screen: earlier grading runs and their backups, with Back Up
  Now, Restore (after a confirmation that lists what happens) and Open
  Run. Restoring never changes original submissions or exported files.
  Tier: COULD. Owner: Damien.
  Controller: gradezzy.ui.HistoryController
  AI use: drafted with Claude Code, reviewed by Jun Sheng.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.HistoryController">
    <VBox styleClass="page">
        <VBox styleClass="page-heading">
            <HBox styleClass="page-header">
                <Label text="History" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="restoreButton" text="Restore"
                        onAction="#handleRestore"/>
                <Button fx:id="openButton" text="Open Run"
                        onAction="#handleOpenRun"/>
                <Button fx:id="backupButton" text="Back Up Now"
                        styleClass="accent, primary-action"
                        onAction="#handleBackup"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="page-status"
                   wrapText="true" minHeight="-Infinity"/>
        </VBox>

        <GridPane fx:id="columns" hgap="16" vgap="16" VBox.vgrow="ALWAYS">
            <VBox fx:id="tablePanel" styleClass="panel, flush">
                <TableView fx:id="table" styleClass="tall-rows"
                           VBox.vgrow="ALWAYS" minHeight="260"
                           accessibleText="Grading runs and their backups"/>
            </VBox>

            <VBox fx:id="detailPanel" styleClass="panel">
                <Label text="SELECTED RUN" styleClass="eyebrow"/>
                <Label fx:id="runTitle" styleClass="panel-title"
                       wrapText="true" minHeight="-Infinity"/>
                <HBox fx:id="runBadgeHolder"/>
                <GridPane fx:id="detailGrid" styleClass="detail-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="70"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Started" styleClass="detail-name"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="startedLabel" wrapText="true"
                           minHeight="-Infinity"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Section" styleClass="detail-name"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="sectionLabel" wrapText="true"
                           minHeight="-Infinity"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="State" styleClass="detail-name"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="stateLabel" wrapText="true"
                           minHeight="-Infinity"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Backup" styleClass="detail-name"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="backupLabel" wrapText="true"
                           minHeight="-Infinity"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
                <Label text="WHAT RESTORE DOES" styleClass="eyebrow"/>
                <VBox fx:id="consequenceBox" spacing="8"/>
                <Label fx:id="restoreNote" styleClass="secondary-text"
                       wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>

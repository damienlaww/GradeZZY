<?xml version="1.0" encoding="UTF-8"?>

<!--
  Similarity Review screen: the pairs of submissions at or above the
  similarity threshold, and for the chosen pair the two compared files,
  matching excerpts side by side and the starter and tester files left
  out. Similarity is a review aid for the instructor, never a finding.
  Controller: gradezzy.ui.PlagiarismController
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gradezzy.ui.PlagiarismController">
    <VBox styleClass="page">
        <VBox styleClass="page-heading">
            <HBox styleClass="page-header">
                <Label text="Similarity Review" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="checkButton" text="Check Again"
                        onAction="#handleRunCheck"/>
                <Button fx:id="reviewButton" text="Mark Pair Reviewed"
                        styleClass="accent, primary-action"
                        onAction="#handleMarkReviewed"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="page-status"
                   wrapText="true" minHeight="-Infinity"/>
        </VBox>

        <HBox fx:id="disabledBanner" styleClass="banner">
            <Label fx:id="disabledLabel" wrapText="true" maxWidth="Infinity"
                   minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Open Settings" styleClass="link-button"
                    onAction="#handleOpenSettings"/>
        </HBox>

        <VBox fx:id="emptyHolder"/>

        <GridPane fx:id="columns" hgap="16" vgap="16">
            <VBox fx:id="pairsPanel" styleClass="panel, flush">
                <HBox styleClass="panel-header">
                    <Label text="Pairs to compare" styleClass="panel-title"/>
                </HBox>
                <ListView fx:id="pairList" VBox.vgrow="ALWAYS">
                    <accessibleText>
                        Similar pairs at or above the threshold
                    </accessibleText>
                </ListView>
            </VBox>

            <VBox fx:id="detailPanel" styleClass="panel">
                <Label fx:id="pairTitle" styleClass="panel-title"
                       wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="pairSummary" styleClass="secondary-text"
                       wrapText="true" minHeight="-Infinity"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <HBox fx:id="decisionHolder"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="undoButton" text="Undo Decision"
                            onAction="#handleUndoDecision"/>
                </HBox>

                <VBox fx:id="compareBox" spacing="12">
                    <GridPane fx:id="codeColumns" hgap="12" vgap="12">
                        <VBox fx:id="firstBox" spacing="8">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label fx:id="firstName"
                                       styleClass="context-value"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Open Evidence"
                                        styleClass="link-button"
                                        onAction="#handleOpenFirst"/>
                            </HBox>
                            <Label fx:id="firstFile"
                                   styleClass="secondary-text, mono"
                                   wrapText="true" minHeight="-Infinity"/>
                            <TextArea fx:id="firstCode" styleClass="code-view"
                                      editable="false" prefRowCount="8"
                                      VBox.vgrow="ALWAYS"
                                      prefColumnCount="20"/>
                        </VBox>
                        <VBox fx:id="secondBox" spacing="8">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label fx:id="secondName"
                                       styleClass="context-value"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Open Evidence"
                                        styleClass="link-button"
                                        onAction="#handleOpenSecond"/>
                            </HBox>
                            <Label fx:id="secondFile"
                                   styleClass="secondary-text, mono"
                                   wrapText="true" minHeight="-Infinity"/>
                            <TextArea fx:id="secondCode" styleClass="code-view"
                                      editable="false" prefRowCount="8"
                                      VBox.vgrow="ALWAYS"
                                      prefColumnCount="20"/>
                        </VBox>
                    </GridPane>

                    <VBox spacing="4">
                        <Label text="Left out of the comparison"
                               styleClass="context-value"/>
                        <Label styleClass="secondary-text" wrapText="true"
                               minHeight="-Infinity">
                            <text>
                                Starter and tester files are not compared, so
                                code every student was given never counts as
                                similar.
                            </text>
                        </Label>
                        <VBox fx:id="excludedList" spacing="4"/>
                    </VBox>
                </VBox>

                <VBox fx:id="missingHolder"/>

                <HBox styleClass="banner">
                    <Label wrapText="true" minHeight="-Infinity">
                        <text>
                            Similar code can come from shared starter code, a
                            common approach or a short answer. Read both files
                            before deciding anything. GradeZZY never labels a
                            student.
                        </text>
                    </Label>
                </HBox>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
